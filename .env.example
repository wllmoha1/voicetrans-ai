# Secret key for JWT auth tokens
SECRET_KEY=super_secret_voice_call_ai_jwt_key_2026_xyz

# Database URL (Defaults to SQLite in local directory)
DATABASE_URL=sqlite:///./voice_call.db

# Groq API Key (Recommended for ultra-fast Whisper STT ~200ms and Llama 3.3 Translation ~100ms)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: OpenAI API Key (if you wish to use OpenAI Whisper & GPT-4o-mini)
OPENAI_API_KEY=

# Optional: Google Gemini API Key
GEMINI_API_KEY=
